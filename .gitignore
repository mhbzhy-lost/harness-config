# 凭据与本机产物，绝不入库
.env
node_modules/
*.bak.*
.DS_Store
__pycache__/

# home-connect 运行时凭据（config 下保留 *.example 模板）
plugins/home-connect/.ssh/
plugins/home-connect/.remote-files/
plugins/home-connect/config/*
!plugins/home-connect/config/*.example

# Pi 本机代理覆盖（实际配置位于 ~/.pi/agent/openai-proxy.json，仓内仅保留 example）
pi/openai-proxy.json

# Pi 官方文档本机软链（由 init-pi.sh 按本机 @earendil-works/pi-coding-agent 路径生成，不入库）
.agents/skills/pi-docs/docs
.agents/skills/pi-docs/examples
.agents/skills/pi-docs/schemas
.agents/skills/pi-docs/README.md
