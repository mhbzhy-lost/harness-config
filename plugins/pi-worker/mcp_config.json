{
  "mcpServers": {
    "pi-worker": {
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/src/server.ts"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "timeoutSeconds": -1,
      "env": {
        "PI_WORKER_AGY": "1"
      },
      "tools": {
        "pi_worker_start": {
          "background": "always",
          "eager": true
        },
        "pi_worker_reply": {
          "background": "always",
          "eager": true
        },
        "pi_worker_monitor": {
          "eager": true
        }
      }
    }
  }
}
